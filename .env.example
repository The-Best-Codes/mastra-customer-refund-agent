OPENAI_API_KEY=

# Optional: libSQL/Turso database for Mastra storage and the case store (src/mastra/lib/case-store.ts).
# Defaults to the local file:./mastra.db used by `mastra dev`. Set these for any real deployment -
# `mastra env db create --kind turso` provisions and injects them automatically on Mastra platform.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: point the support pipeline at a real provider instead of the built-in mock adapter.
# One of: mock (default), zendesk. See src/mastra/integrations/*.ts for setup details.
SUPPORT_SOURCE=mock

# Required when SUPPORT_SOURCE=zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_SCOPE="tickets:read tickets:write users:read"
ZENDESK_WEBHOOK_SECRET=
