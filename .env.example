OPENAI_API_KEY=

# Optional: point the support pipeline at a real provider instead of the built-in mock adapter.
# One of: mock (default), zendesk. See src/mastra/integrations/*.ts for setup details.
SUPPORT_SOURCE=mock

# Required when SUPPORT_SOURCE=zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_WEBHOOK_SECRET=
